# -*- mode: ruby -*-
# vi: set ft=ruby :

require 'fileutils'

MINIO_ROOT_USER     = ENV["MINIO_ROOT_USER"]     || raise("MINIO_ROOT_USER env var is required. Example: MINIO_ROOT_USER=minioadmin vagrant up")
MINIO_ROOT_PASSWORD = ENV["MINIO_ROOT_PASSWORD"] || raise("MINIO_ROOT_PASSWORD env var is required. Example: MINIO_ROOT_PASSWORD=minioadmin vagrant up")

Vagrant.configure("2") do |config|
  # minio: 2 vCPU, 2 GB RAM, 50 GB disk, private IP 192.168.56.11
  config.vm.define "minio" do |vm|
    vm.vm.box = "cloud-image/debian-13"
    vm.vm.hostname = "minio"
    vm.vm.synced_folder ".", "/vagrant", disabled: true
    vm.vm.network "private_network", ip: "192.168.56.11"
    # MinIO S3 API
    vm.vm.network "forwarded_port", guest: 9000, host: 9000
    # MinIO Console
    vm.vm.network "forwarded_port", guest: 9001, host: 9001
    vm.vm.disk :disk, size: "50GB", primary: true
    vm.vm.provider "virtualbox" do |vb|
      vb.name = "minio"
      vb.memory = 2048
      vb.cpus = 2
    end
    vm.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y docker.io docker-compose
      systemctl enable docker
      systemctl start docker
      usermod -aG docker vagrant
    SHELL
  end

  # After the VM is up, generate the Ansible inventory automatically.
  config.trigger.after :up do |trigger|
    trigger.name = "Generate Ansible inventory"
    trigger.only_on = "minio"
    trigger.ruby do |env, machine|
      m = env.machine(:minio, :virtualbox)
      info = m.ssh_info
      if info.nil?
        machine.ui.warn "VM 'minio' is not running; skipping inventory generation."
        next
      end

      inventory_dir = File.expand_path("../../ansible/inventory/dev/minio", __dir__)
      FileUtils.mkdir_p(inventory_dir)
      inventory_path = File.join(inventory_dir, "inventory.ini")

      File.write(inventory_path, <<~INI)
        [all]
        minio ansible_host=127.0.0.1 ansible_port=#{info[:port]} ansible_ssh_private_key_file=#{info[:private_key_path]&.first}

        [containers]
        minio

        [minio]
        minio

        [all:vars]
        ansible_user=vagrant
        ansible_python_interpreter=/usr/bin/python3.13
        minio_root_user=#{MINIO_ROOT_USER}
        minio_root_password=#{MINIO_ROOT_PASSWORD}
      INI

      machine.ui.success "Inventory written to: #{inventory_path}"
    end
  end
end
